# ---------- Shared ----------
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379
# 32-byte key as 64 hex chars. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Where uploaded avatars/banners/attachments live (shared volume between web and bot)
UPLOAD_DIR=./uploads

# ---------- Web (Auth.js) ----------
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# First owner (can always request a sign-in link). Others are invited from the Team page.
OWNER_EMAIL=
# Email for sign-in/invite links: set ONE of these
#   Resend: https://resend.com (needs a verified domain to email anyone other than yourself)
RESEND_API_KEY=
#   or SMTP, e.g. Gmail with an App Password: smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
EMAIL_FROM=Nexus Bot Control <you@example.com>
# Where the web app can reach the bot worker health endpoint
BOT_HEALTH_URL=http://localhost:8081/health

# ---------- Bot worker ----------
HEALTH_PORT=8081
DELIVERY_CONCURRENCY=5
LOG_LEVEL=info

# ---------- Supabase (production) ----------
# Postgres: use the dedicated role + schema, e.g.
# DATABASE_URL=postgresql://nexus_app:<password>@db.<ref>.supabase.co:5432/postgres?schema=nexus&sslmode=require
# Asset storage (Supabase Storage). Leave empty to use UPLOAD_DIR locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ASSET_BUCKET=nexus-assets
# Auth.js behind a proxy (Railway)
AUTH_TRUST_HOST=true
