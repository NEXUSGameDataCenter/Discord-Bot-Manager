# ---------- Shared ----------
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379
# 32-byte key as 64 hex chars. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Where uploaded avatars/banners/attachments live (shared volume between web and bot)
UPLOAD_DIR=./uploads

# ---------- Web (Auth.js) ----------
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# First owner. Can always get a recovery sign-in link written to the web log.
OWNER_EMAIL=

# ---------- Bot worker ----------
HEALTH_PORT=8081
DELIVERY_CONCURRENCY=5
LOG_LEVEL=info

# ---------- Supabase (production) ----------
# Postgres: use the dedicated role + schema, e.g.
# DATABASE_URL=postgresql://nexus_app:<password>@db.<ref>.supabase.co:5432/postgres?schema=nexus&sslmode=require
# Asset storage (Supabase Storage). Leave empty to use UPLOAD_DIR locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ASSET_BUCKET=nexus-assets
# Auth.js behind a proxy (Railway)
AUTH_TRUST_HOST=true
